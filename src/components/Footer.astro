---
import { localePath, type Locale } from '../lib/i18n';
import type { Translate } from '../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
}

const { locale, tr } = Astro.props;

const productLinks = [
  { label: tr('nav.home'), href: localePath(locale, '/') },
  { label: tr('nav.formats'), href: localePath(locale, '/formats') },
  { label: tr('nav.howItWorks'), href: localePath(locale, '/how-it-works') },
];

const companyLinks = [
  { label: tr('nav.about'), href: localePath(locale, '/about') },
  { label: tr('nav.privacy'), href: localePath(locale, '/privacy') },
  { label: tr('terms.eyebrow'), href: localePath(locale, '/terms') },
  { label: tr('contact.eyebrow'), href: localePath(locale, '/contact') },
];
---

{/* Footer — Apple style: directory columns, calm fine print */}
<footer class="border-t border-hairline bg-card/50">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      {/* Brand */}
      <div class="max-w-xs">
        <p class="flex items-center gap-2 text-[17px] font-semibold tracking-tight">
          <img src="/logo.svg" alt="" class="h-7 w-7" />
          PureClear
        </p>
        <p class="mt-3 text-[14px] leading-relaxed text-ink-2">{tr('footer.tagline')}</p>
        <p class="mt-3 text-[14px] leading-relaxed text-ink-2">{tr('footer.note')}</p>
      </div>
      {/* Product column */}
      <nav aria-label={tr('footer.product')}>
        <p class="text-[13px] font-semibold uppercase tracking-[0.06em] text-ink">
          {tr('footer.product')}
        </p>
        <ul class="mt-4 space-y-3 text-[14px]">
          {
            productLinks.map((l) => (
              <li>
                <a class="text-ink-2 transition-colors hover:text-ink" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {/* Company column */}
      <nav aria-label={tr('footer.company')}>
        <p class="text-[13px] font-semibold uppercase tracking-[0.06em] text-ink">
          {tr('footer.company')}
        </p>
        <ul class="mt-4 space-y-3 text-[14px]">
          {
            companyLinks.map((l) => (
              <li>
                <a class="text-ink-2 transition-colors hover:text-ink" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    {/* Fine print */}
    <div class="mt-12 border-t border-hairline pt-6">
      <p class="text-[12px] leading-relaxed text-ink-2">{tr('footer.rights')}</p>
      <p class="mt-2 text-[12px] leading-relaxed text-ink-2">{tr('footer.fineprint')}</p>
    </div>
  </div>
</footer>
