---
import { localePath, type Locale } from '../lib/i18n';
import type { Translate } from '../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
}

const { locale, tr } = Astro.props;
---

{/* Footer — Apple style: fine print, calm, minimal */}
<footer class="border-t border-hairline bg-card/50">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-xs">
        <p class="flex items-center gap-2 text-[17px] font-semibold tracking-tight">
          <img src="/logo.svg" alt="" class="h-6 w-6" />
          PureClear
        </p>
        <p class="mt-2 text-[13px] leading-relaxed text-ink-2">{tr('footer.tagline')}</p>
      </div>
      <nav
        class="grid grid-cols-2 gap-x-12 gap-y-3 text-[14px] sm:flex sm:gap-x-8"
        aria-label="Footer"
      >
        <a
          class="text-ink-2 transition-colors hover:text-ink"
          href={localePath(locale, '/how-it-works')}
        >
          {tr('nav.howItWorks')}
        </a>
        <a
          class="text-ink-2 transition-colors hover:text-ink"
          href={localePath(locale, '/about')}
        >
          {tr('nav.about')}
        </a>
        <a
          class="text-ink-2 transition-colors hover:text-ink"
          href={localePath(locale, '/privacy')}
        >
          {tr('nav.privacy')}
        </a>
      </nav>
    </div>
    <p class="mt-10 border-t border-hairline pt-6 text-[12px] leading-relaxed text-ink-2">
      {tr('footer.rights')}
    </p>
  </div>
</footer>
