---
import ToolIsland from '../tool/ToolIsland';
import Faq from '../Faq.astro';
import { getRawMessages } from '../../lib/messages';
import type { Locale } from '../../lib/i18n';
import type { Translate } from '../../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
  format: string;
}

const { locale, tr, format } = Astro.props;
const upper = format.toUpperCase();
const messages = getRawMessages(locale);
---

{/* Format hero — Apple style: eyebrow pill + massive headline */}
<section class="mx-auto max-w-6xl px-4 pt-16 text-center sm:px-6 sm:pt-24">
  <p
    class="inline-flex items-center rounded-full bg-accent/10 px-4 py-1.5 text-[13px] font-semibold uppercase tracking-[0.06em] text-accent"
  >
    {upper}
  </p>
  <h1
    class="mx-auto mt-5 max-w-3xl text-[clamp(2rem,5vw,3.5rem)] font-semibold leading-[1.08] tracking-[-0.025em]"
  >
    {tr('formats.title', { format: upper })}
  </h1>
  <p class="mx-auto mt-5 max-w-2xl text-[17px] leading-relaxed text-ink-2">
    {tr('formats.description', { format: upper })}
  </p>

  {/* Tool only — no duplicate hero text */}
  <div class="mx-auto mt-12 max-w-3xl text-start sm:mt-16">
    <ToolIsland client:load locale={locale} messages={messages} />
  </div>
</section>
<div class="pb-8"></div>
<Faq tr={tr} />
