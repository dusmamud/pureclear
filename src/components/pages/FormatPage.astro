---
import ToolIsland from '../tool/ToolIsland';
import { getFormat, FORMATS } from '../../data/formats';
import { getRawMessages } from '../../lib/messages';
import { t } from '../../lib/t';
import { localePath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  format: string;
}

const { locale, format } = Astro.props;
const tr = t(locale);
const info = getFormat(format);
if (!info) throw new Error(`Unknown format: ${format}`);
const upper = info.name;
const messages = getRawMessages(locale);
const siblings = FORMATS.filter((f) => f.slug !== info.slug);
const pageUrl = `https://pureclear.dusrel.com${localePath(locale, `/formats/${info.slug}`)}`;

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `PureClear — ${info.seoTitle[locale]}`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: info.seoDescription[locale],
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'PureClear',
      item: `https://pureclear.dusrel.com${localePath(locale, '/')}`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: tr('formats.gridEyebrow'),
      item: `https://pureclear.dusrel.com${localePath(locale, '/formats/jpg')}`,
    },
    { '@type': 'ListItem', position: 3, name: upper, item: pageUrl },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: info.faqs[locale].map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

{/* Format hero — Apple style: eyebrow pill + massive headline + unique intro */}
<section class="mx-auto max-w-6xl px-4 pt-16 text-center sm:px-6 sm:pt-24">
  <p
    class="inline-flex items-center rounded-full bg-accent/10 px-4 py-1.5 text-[13px] font-semibold uppercase tracking-[0.06em] text-accent"
  >
    {upper}
  </p>
  <h1
    class="mx-auto mt-5 max-w-3xl text-[clamp(2rem,5vw,3.5rem)] font-semibold leading-[1.08] tracking-[-0.025em]"
  >
    {tr('formats.title', { format: upper })}
  </h1>
  <p class="mx-auto mt-5 max-w-2xl text-[17px] leading-relaxed text-ink-2">
    {info.intro[locale]}
  </p>

  {/* Shared tool — one component, every format. Never duplicated. */}
  <div class="mx-auto mt-12 max-w-3xl text-start sm:mt-16">
    <ToolIsland client:load locale={locale} messages={messages} />
  </div>
</section>

{/* What gets removed — per-format, unique content */}
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
  <div class="text-center">
    <p
      class="text-[13px] font-semibold uppercase tracking-[0.08em] text-accent"
    >
      {upper}
    </p>
    <h2
      class="mx-auto mt-3 max-w-2xl text-[clamp(1.75rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
    >
      {tr('formats.whatRemoved')}
    </h2>
  </div>
  <ul
    class="mx-auto mt-10 grid max-w-4xl grid-cols-1 gap-3 sm:mt-12 sm:grid-cols-2 sm:gap-4"
  >
    {
      info.removed[locale].map((item) => (
        <li class="flex items-start gap-3 rounded-2xl bg-card p-5 shadow-[0_1px_2px_rgba(0,0,0,0.04)] ring-1 ring-hairline">
          <svg
            class="mt-0.5 h-5 w-5 shrink-0 text-accent"
            viewBox="0 0 256 256"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z" />
          </svg>
          <span class="text-[15px] font-medium leading-[1.5]">{item}</span>
        </li>
      ))
    }
  </ul>
</section>

{/* Per-format FAQs — unique content, Apple accordion */}
<section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 sm:pb-24">
  <h2
    class="text-center text-[clamp(1.75rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
  >
    {tr('formats.faqTitle')}
  </h2>
  <div
    class="mt-10 overflow-hidden rounded-3xl bg-card shadow-[0_1px_2px_rgba(0,0,0,0.04)] ring-1 ring-hairline sm:mt-12"
  >
    {
      info.faqs[locale].map((f, i) => (
        <details
          class={`group px-6 py-5 transition-colors hover:bg-black/[0.02] dark:hover:bg-white/[0.03] sm:px-8 sm:py-6 ${i > 0 ? 'border-t border-hairline' : ''}`}
        >
          <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              <span class="text-[17px] font-semibold tracking-[-0.01em]">{f.q}</span>
              <svg
                class="h-4 w-4 shrink-0 text-ink-2 transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-open:rotate-180"
                viewBox="0 0 256 256"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M213.66,165.66a8,8,0,0,1-11.32,0L128,91.31,53.66,165.66a8,8,0,0,1-11.32-11.32l80-80a8,8,0,0,1,11.32,0l80,80A8,8,0,0,1,213.66,165.66Z" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 max-w-2xl text-[15px] leading-[1.6] text-ink-2">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>

{/* Sibling formats — internal linking */}
<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-28">
  <h2
    class="text-center text-[clamp(1.5rem,3.5vw,2.25rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
  >
    {tr('formats.siblings')}
  </h2>
  <div class="mx-auto mt-8 grid max-w-4xl grid-cols-2 gap-3 sm:mt-10 sm:grid-cols-4 sm:gap-4">
    {
      siblings.map((s) => (
        <a
          href={localePath(locale, `/formats/${s.slug}`)}
          class="group rounded-2xl bg-card p-5 ring-1 ring-hairline transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(0,0,0,0.08)]"
        >
          <div class="flex items-start justify-between gap-2">
            <p class="text-[15px] font-semibold tracking-[-0.01em]">{s.name}</p>
            <svg
              viewBox="0 0 256 256"
              fill="currentColor"
              aria-hidden="true"
              class="h-7 w-7 shrink-0 text-ink-2/60 transition-colors duration-300 group-hover:text-ink-2"
            >
              <path d={s.icon} />
            </svg>
          </div>
          <p class="mt-1 text-[13px] leading-snug text-ink-2">{s.tagline[locale]}</p>
          <span class="mt-3 inline-flex items-center gap-1 text-[13px] font-semibold text-accent">
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5">→</span>
          </span>
        </a>
      ))
    }
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
