---
import Hero from '../Hero.astro';
import Faq from '../Faq.astro';
import type { Locale } from '../../lib/i18n';
import type { Translate } from '../../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
  format: string;
}

const { locale, tr, format } = Astro.props;
const upper = format.toUpperCase();
---

<section class="mx-auto max-w-6xl px-4 pt-14 sm:px-6">
  <p class="text-sm font-medium text-accent">{upper}</p>
  <h1 class="mt-2 max-w-3xl text-[clamp(1.75rem,4vw,3rem)] font-semibold tracking-tight">
    {tr('formats.title', { format: upper })}
  </h1>
  <p class="mt-4 max-w-2xl text-ink-2">{tr('formats.description', { format: upper })}</p>
</section>
<Hero locale={locale} tr={tr} />
<Faq tr={tr} />
