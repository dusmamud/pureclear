---
import { localePath, type Locale } from '../../lib/i18n';
import type { Translate } from '../../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
}

const { locale, tr } = Astro.props;

const sections = [1, 2, 3, 4, 5, 6, 7].map((n) => ({
  title: tr(`terms.s${n}t`),
  body: tr(`terms.s${n}b`),
}));
---

{/* Hero — Apple style */}
<section class="mx-auto max-w-6xl px-4 pb-12 pt-16 text-center sm:px-6 sm:pb-16 sm:pt-24">
  <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-accent">
    {tr('terms.eyebrow')}
  </p>
  <h1
    class="mx-auto mt-4 max-w-4xl text-[clamp(2.25rem,5.5vw,4rem)] font-semibold leading-[1.06] tracking-[-0.025em]"
  >
    {tr('terms.title')}
  </h1>
  <p
    class="mx-auto mt-6 max-w-2xl text-[clamp(1.0625rem,2vw,1.3125rem)] leading-[1.5] tracking-[-0.01em] text-ink-2"
  >
    {tr('terms.intro')}
  </p>
</section>

{/* Sections — numbered, generous */}
<section class="border-t border-hairline bg-card/40">
  <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
    <ol class="space-y-12 sm:space-y-16">
      {
        sections.map((s, i) => (
          <li class="flex gap-5 sm:gap-7">
            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent/10 text-[15px] font-semibold text-accent"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div>
              <h2 class="text-[21px] font-semibold tracking-[-0.01em] sm:text-[24px]">
                {s.title}
              </h2>
              <p class="mt-3 text-[16px] leading-[1.65] text-ink-2 sm:text-[17px]">
                {s.body}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="mt-16 text-[14px] text-ink-2">{tr('terms.updated')}</p>

    {/* CTA */}
    <div class="mt-12 rounded-[28px] bg-ink px-8 py-12 text-center text-canvas sm:py-16 dark:bg-white dark:text-black">
      <h2 class="mx-auto max-w-xl text-[clamp(1.5rem,3.5vw,2.25rem)] font-semibold tracking-[-0.02em]">
        {tr('terms.ctaTitle')}
      </h2>
      <p class="mx-auto mt-3 max-w-md text-[16px] opacity-70">{tr('terms.ctaBody')}</p>
      <a
        href={localePath(locale, '/contact')}
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-[16px] font-semibold text-white transition-transform duration-200 hover:scale-[1.03] active:scale-[0.98]"
      >
        {tr('terms.ctaButton')}
      </a>
    </div>
  </div>
</section>
