---
import { localePath, type Locale } from '../../lib/i18n';
import type { Translate } from '../../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
}

const { locale, tr } = Astro.props;

const problems = [1, 2, 3].map((n) => ({
  title: tr(`about.p${n}t`),
  body: tr(`about.p${n}b`),
}));

const principles = [1, 2, 3, 4].map((n) => ({
  title: tr(`about.pr${n}t`),
  body: tr(`about.pr${n}b`),
}));
---

{/* Hero — Apple style: eyebrow, massive title, intro */}
<section class="mx-auto max-w-6xl px-4 pb-16 pt-16 text-center sm:px-6 sm:pb-24 sm:pt-24">
  <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-accent">
    {tr('about.eyebrow')}
  </p>
  <h1
    class="mx-auto mt-4 max-w-4xl text-[clamp(2.25rem,5.5vw,4rem)] font-semibold leading-[1.06] tracking-[-0.025em]"
  >
    {tr('about.title')}
  </h1>
  <p
    class="mx-auto mt-6 max-w-2xl text-[clamp(1.0625rem,2vw,1.3125rem)] leading-[1.5] tracking-[-0.01em] text-ink-2"
  >
    {tr('about.intro')}
  </p>
</section>

{/* The problem — Apple style: editorial section with cards */}
<section class="border-t border-hairline bg-card/40">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-accent">
        {tr('about.problemEyebrow')}
      </p>
      <h2
        class="mt-3 text-[clamp(1.75rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
      >
        {tr('about.problemTitle')}
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-[17px] leading-[1.6] text-ink-2">
        {tr('about.problemBody')}
      </p>
    </div>
    <div class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-5 sm:mt-16 md:grid-cols-3">
      {
        problems.map((p) => (
          <article class="rounded-card bg-card p-8 shadow-card transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:shadow-[0_12px_40px_rgb(0_0_0/0.1)]">
            <h3 class="text-[19px] font-semibold tracking-[-0.01em]">{p.title}</h3>
            <p class="mt-2.5 text-[15px] leading-[1.6] text-ink-2">{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

{/* Principles — Apple style: 2x2 grid */}
<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
  <div class="mx-auto max-w-3xl text-center">
    <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-accent">
      {tr('about.principlesEyebrow')}
    </p>
    <h2
      class="mt-3 text-[clamp(1.75rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
    >
      {tr('about.principlesTitle')}
    </h2>
  </div>
  <div class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-5 sm:mt-16 sm:grid-cols-2">
    {
      principles.map((p, i) => (
        <article class="group relative overflow-hidden rounded-card bg-card p-8 shadow-card transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:shadow-[0_12px_40px_rgb(0_0_0/0.1)]">
          <span
            class="pointer-events-none absolute -right-2 -top-7 select-none text-[110px] font-bold leading-none tracking-tighter text-accent/[0.07]"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <h3 class="text-[21px] font-semibold tracking-[-0.01em]">{p.title}</h3>
          <p class="mt-2.5 text-[16px] leading-[1.6] text-ink-2">{p.body}</p>
        </article>
      ))
    }
  </div>
</section>

{/* CTA — Apple style: centered, bold */}
<section class="border-t border-hairline bg-card/40">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 sm:py-28">
    <h2
      class="text-[clamp(1.75rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
    >
      {tr('about.ctaTitle')}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-[17px] leading-relaxed text-ink-2">
      {tr('about.ctaBody')}
    </p>
    <a
      href={localePath(locale, '/')}
      class="mt-8 inline-flex items-center justify-center rounded-pill bg-accent px-8 py-3.5 text-[17px] font-medium text-white transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-accent-hover active:scale-[0.97]"
    >
      {tr('about.ctaButton')}
    </a>
  </div>
</section>
