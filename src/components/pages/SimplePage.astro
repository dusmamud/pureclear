---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  titleKey: string;
  bodyKey: string;
  tr: (key: string) => string;
}

const { titleKey, bodyKey, tr } = Astro.props;
---

{/* Article page — Apple style: centered, generous, readable */}
<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
  <h1
    class="text-center text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-[1.1] tracking-[-0.025em]"
  >
    {tr(titleKey)}
  </h1>
  <div class="mx-auto mt-8 max-w-2xl space-y-5 text-[17px] leading-[1.65] tracking-[-0.005em] text-ink-2 sm:mt-10">
    <p>{tr(bodyKey)}</p>
  </div>
</section>
