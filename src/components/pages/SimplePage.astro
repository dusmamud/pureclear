---
import type { Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  titleKey: string;
  bodyKey: string;
  tr: (key: string) => string;
}

const { titleKey, bodyKey, tr } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
  <h1 class="text-[clamp(1.75rem,4vw,2.75rem)] font-semibold tracking-tight">{tr(titleKey)}</h1>
  <div class="prose-custom mt-6 space-y-4 text-[17px] leading-relaxed text-ink-2">
    <p>{tr(bodyKey)}</p>
  </div>
</section>
