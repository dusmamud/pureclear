---
import { FORMATS } from '../../data/formats';
import { localePath, type Locale } from '../../lib/i18n';
import type { Translate } from '../../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
}

const { locale, tr } = Astro.props;

const steps = [1, 2, 3, 4].map((n) => ({
  title: tr(`how.step${n}Title`),
  body: tr(`how.step${n}Body`),
}));

const removed = [1, 2, 3, 4, 5, 6].map((n) => ({
  title: tr(`how.r${n}t`),
  body: tr(`how.r${n}b`),
}));

const faqs = [1, 2, 3].map((n) => ({
  q: tr(`how.faq${n}q`),
  a: tr(`how.faq${n}a`),
}));

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HowTo',
      name: tr('how.title'),
      description: tr('how.metaDescription'),
      step: steps.map((s, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: s.title,
        text: s.body,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'PureClear',
          item: `https://pureclear.dusrel.com${localePath(locale, '/')}`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: tr('how.title'),
          item: `https://pureclear.dusrel.com${localePath(locale, '/how-it-works')}`,
        },
      ],
    },
  ],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
  {/* Page header — Apple style */}
  <div class="mx-auto max-w-3xl text-center">
    <p class="text-[13px] font-medium text-accent">
      {tr('how.eyebrow') ?? 'How it works'}
    </p>
    <h1
      class="mt-3 text-[clamp(2rem,5vw,3.5rem)] font-semibold leading-[1.08] tracking-[-0.025em]"
    >
      {tr('how.title')}
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-[17px] leading-relaxed text-ink-2">
      {tr('how.subtitle') ?? ''}
    </p>
  </div>

  {/* Steps — Apple style: spacious cards with large numerals */}
  <ol class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-5 sm:mt-16 sm:grid-cols-2">
    {
      steps.map((s, i) => (
        <li class="rounded-card bg-card p-8 shadow-card transition-[background-color,box-shadow] duration-200 ease-apple hover:shadow-[0_8px_24px_rgba(0,0,0,0.08)]">
          <span
            class="flex h-11 w-11 items-center justify-center rounded-full bg-accent text-[17px] font-semibold text-white"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <h2 class="mt-5 text-[21px] font-semibold tracking-[-0.01em]">{s.title}</h2>
          <p class="mt-2.5 text-[16px] leading-[1.55] text-ink-2">{s.body}</p>
        </li>
      ))
    }
  </ol>
</section>

{/* What gets removed — Apple style: deep-clean grid */}
<section class="border-t border-hairline bg-card/40">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-[13px] font-medium text-accent">
        {tr('how.removedEyebrow')}
      </p>
      <h2
        class="mt-3 text-[clamp(1.75rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
      >
        {tr('how.removedTitle')}
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-[17px] leading-[1.6] text-ink-2">
        {tr('how.removedBody')}
      </p>
    </div>
    <div class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-5 sm:mt-16 sm:grid-cols-2 lg:grid-cols-3">
      {
        removed.map((r) => (
          <article class="rounded-card bg-card p-7 shadow-card transition-[background-color,box-shadow] duration-200 ease-apple hover:shadow-[0_8px_24px_rgba(0,0,0,0.08)]">
            <h3 class="text-[18px] font-semibold tracking-[-0.01em]">{r.title}</h3>
            <p class="mt-2 text-[15px] leading-[1.6] text-ink-2">{r.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

{/* Formats — internal links to every format page */}
<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
  <h2
    class="text-[clamp(1.5rem,3vw,2rem)] font-semibold leading-[1.15] tracking-[-0.02em]"
  >
    {tr('how.formatsTitle')}
  </h2>
  <p class="mx-auto mt-5 max-w-2xl text-[16px] leading-[1.7] text-ink-2">
    {
      FORMATS.map((f, i) => (
        <>
          <a
            href={localePath(locale, `/formats/${f.slug}`)}
            class="font-medium text-accent underline-offset-4 hover:underline"
          >
            {f.name}
          </a>
          {i < FORMATS.length - 1 ? ' · ' : ''}
        </>
      ))
    }
  </p>
</section>

{/* FAQ — process questions, same accordion as the homepage */}
<section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6 sm:pb-20">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-[13px] font-medium text-accent">
      {tr('faq.eyebrow') ?? 'FAQ'}
    </p>
    <h2
      class="mt-3 text-[clamp(1.75rem,4vw,2.5rem)] font-semibold leading-[1.12] tracking-[-0.02em]"
    >
      {tr('faq.title')}
    </h2>
  </div>
  <div class="mt-10 overflow-hidden rounded-card bg-card shadow-card sm:mt-12">
    {
      faqs.map((f, i) => (
        <details
          class={`group px-6 py-5 transition-colors hover:bg-black/[0.02] dark:hover:bg-white/[0.03] sm:px-8 sm:py-6 ${i > 0 ? 'border-t border-hairline' : ''}`}
        >
          <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              <span class="text-[17px] font-semibold tracking-[-0.01em]">{f.q}</span>
              <svg
                class="h-4 w-4 shrink-0 text-ink-2 transition-transform duration-200 ease-apple group-open:rotate-180"
                viewBox="0 0 256 256"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M213.66,165.66a8,8,0,0,1-11.32,0L128,91.31,53.66,165.66a8,8,0,0,1-11.32-11.32l80-80a8,8,0,0,1,11.32,0l80,80A8,8,0,0,1,213.66,165.66Z" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 max-w-2xl text-[15px] leading-[1.6] text-ink-2">{f.a}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
</section>

{/* CTA — Apple style: centered, bold */}
<section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 sm:py-28">
  <h2
    class="text-[clamp(1.75rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
  >
    {tr('how.ctaTitle')}
  </h2>
  <p class="mx-auto mt-4 max-w-xl text-[17px] leading-relaxed text-ink-2">
    {tr('how.ctaBody')}
  </p>
  <a
    href={localePath(locale, '/')}
    class="mt-8 inline-flex items-center justify-center rounded-pill bg-accent px-8 py-3.5 text-[17px] font-medium text-white transition-[color,background-color,transform] duration-200 ease-apple hover:bg-accent-hover active:scale-[0.97]"
  >
    {tr('how.ctaButton')}
  </a>
</section>
