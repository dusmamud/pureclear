---
import { localePath, type Locale } from '../../lib/i18n';
import type { Translate } from '../../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
}

const { locale, tr } = Astro.props;

const topics = [1, 2, 3].map((n) => ({
  title: tr(`contact.t${n}t`),
  body: tr(`contact.t${n}b`),
}));
---

{/* Hero — Apple style */}
<section class="mx-auto max-w-6xl px-4 pb-12 pt-16 text-center sm:px-6 sm:pb-16 sm:pt-24">
  <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-accent">
    {tr('contact.eyebrow')}
  </p>
  <h1
    class="mx-auto mt-4 max-w-4xl text-[clamp(2.25rem,5.5vw,4rem)] font-semibold leading-[1.06] tracking-[-0.025em]"
  >
    {tr('contact.title')}
  </h1>
  <p
    class="mx-auto mt-6 max-w-2xl text-[clamp(1.0625rem,2vw,1.3125rem)] leading-[1.5] tracking-[-0.01em] text-ink-2"
  >
    {tr('contact.intro')}
  </p>

  {/* Email card */}
  <div class="mx-auto mt-10 max-w-xl sm:mt-12">
    <a
      href="mailto:pureclear@dusrel.com"
      class="group flex items-center justify-between gap-4 rounded-[24px] bg-card p-6 text-start ring-1 ring-hairline transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_32px_rgba(0,0,0,0.1)] sm:p-7"
    >
      <div>
        <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-accent">
          {tr('contact.emailLabel')}
        </p>
        <p class="mt-2 text-[20px] font-semibold tracking-[-0.01em] sm:text-[24px]">
          pureclear@dusrel.com
        </p>
      </div>
      <span
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-white"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 256 256"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M224,48H32A16,16,0,0,0,16,64V192a16,16,0,0,0,16,16H224a16,16,0,0,0,16-16V64A16,16,0,0,0,224,48Zm-96,89.86L48,64H208ZM128,152,48,80.28V192H208V80.28Z"
          />
        </svg>
      </span>
    </a>
    <p class="mt-4 text-[14px] text-ink-2">{tr('contact.note')}</p>
  </div>
</section>

{/* Topics */}
<section class="border-t border-hairline bg-card/40">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <h2
      class="text-center text-[clamp(1.75rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
    >
      {tr('contact.topicsTitle')}
    </h2>
    <div class="mx-auto mt-10 grid max-w-5xl grid-cols-1 gap-4 sm:mt-12 sm:grid-cols-3">
      {
        topics.map((t, i) => (
          <div class="rounded-[20px] bg-card p-6 ring-1 ring-hairline sm:p-7">
            <span
              class="flex h-10 w-10 items-center justify-center rounded-full bg-accent/10 text-[15px] font-semibold text-accent"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="mt-4 text-[18px] font-semibold tracking-[-0.01em]">{t.title}</h3>
            <p class="mt-2 text-[15px] leading-[1.6] text-ink-2">{t.body}</p>
          </div>
        ))
      }
    </div>

    {/* Link cards — report a problem / share feedback */}
    <div class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-6 sm:grid-cols-2">
      <a
        href={localePath(locale, '/report')}
        class="group rounded-[24px] bg-card p-6 ring-1 ring-hairline transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_32px_rgba(0,0,0,0.1)] sm:p-8"
      >
        <h3 class="text-[20px] font-semibold tracking-[-0.01em]">
          {tr('contact.reportCardTitle')}
        </h3>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-2">
          {tr('contact.reportCardBody')}
        </p>
        <span class="mt-4 inline-flex items-center gap-1.5 text-[15px] font-semibold text-accent">
          {tr('contact.openForm')}
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z" />
          </svg>
        </span>
      </a>
      <a
        href={localePath(locale, '/feedback')}
        class="group rounded-[24px] bg-card p-6 ring-1 ring-hairline transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_12px_32px_rgba(0,0,0,0.1)] sm:p-8"
      >
        <h3 class="text-[20px] font-semibold tracking-[-0.01em]">
          {tr('contact.feedbackCardTitle')}
        </h3>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-2">
          {tr('contact.feedbackCardBody')}
        </p>
        <span class="mt-4 inline-flex items-center gap-1.5 text-[15px] font-semibold text-accent">
          {tr('contact.openForm')}
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z" />
          </svg>
        </span>
      </a>
    </div>

    {/* Back CTA */}
    <div class="mt-16 text-center">
      <a
        href={localePath(locale, '/')}
        class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-[16px] font-semibold text-white transition-transform duration-200 hover:scale-[1.03] active:scale-[0.98]"
      >
        {tr('contact.ctaButton')}
      </a>
    </div>
  </div>
</section>
