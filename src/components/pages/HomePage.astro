---
import Hero from '../Hero.astro';
import Bento from '../Bento.astro';
import FormatsGrid from '../FormatsGrid.astro';
import LifestyleBand from '../LifestyleBand.astro';
import Faq from '../Faq.astro';
import type { Locale } from '../../lib/i18n';
import type { Translate } from '../../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
}

const { locale, tr } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'PureClear',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: tr('meta.description'),
};
---

<Hero locale={locale} tr={tr} />
{/* Phone visual — Apple style product shot above Why PureClear */}
<div class="mx-auto -mt-6 max-w-3xl px-4 sm:-mt-10 sm:px-6">
  <img
    src="/images/hero-phone.webp"
    alt={tr('hero.imageAlt')}
    class="h-auto w-full"
    width="1920"
    height="1280"
    loading="lazy"
  />
</div>
<Bento tr={tr} />
<FormatsGrid locale={locale} />
<LifestyleBand tr={tr} />
<Faq tr={tr} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
