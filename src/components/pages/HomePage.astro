---
import Hero from '../Hero.astro';
import Bento from '../Bento.astro';
import FormatsGrid from '../FormatsGrid.astro';
import LifestyleBand from '../LifestyleBand.astro';
import Faq from '../Faq.astro';
import { FORMATS } from '../../data/formats';
import type { Locale } from '../../lib/i18n';
import type { Translate } from '../../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
}

const { locale, tr } = Astro.props;

// OpenSearch ?q= targets: match a format by slug, name or extension.
const formatKeys = FORMATS.map((f) => ({
  slug: f.slug,
  keys: [f.slug, f.name.toLowerCase(), ...f.extensions],
}));
const localePrefix = locale === 'en' ? '' : `/${locale}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://pureclear.dusrel.com/#app',
      name: 'PureClear',
      url: 'https://pureclear.dusrel.com/',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web browser',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description: tr('meta.description'),
      publisher: { '@id': 'https://pureclear.dusrel.com/#org' },
    },
    {
      '@type': 'Organization',
      '@id': 'https://pureclear.dusrel.com/#org',
      name: 'PureClear',
      url: 'https://pureclear.dusrel.com/',
      logo: 'https://pureclear.dusrel.com/logo.svg',
      email: 'pureclear@dusrel.com',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://pureclear.dusrel.com/#site',
      url: 'https://pureclear.dusrel.com/',
      name: 'PureClear',
      publisher: { '@id': 'https://pureclear.dusrel.com/#org' },
      inLanguage: ['en', 'hi', 'as'],
    },
  ],
};
---

<Hero locale={locale} tr={tr} />
{/* Phone visual — Apple style product shot above Why PureClear */}
<div class="mx-auto -mt-6 max-w-3xl px-4 sm:-mt-10 sm:px-6">
  <img
    src="/images/hero-phone.webp"
    alt={tr('hero.imageAlt')}
    class="h-auto w-full"
    width="1175"
    height="1025"
    loading="lazy"
  />
</div>
<Bento tr={tr} />
<FormatsGrid locale={locale} />
<LifestyleBand tr={tr} />
<Faq tr={tr} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
<script is:inline define:vars={{ formatKeys, localePrefix }}>
  // OpenSearch ?q= handling: a matching format name/slug/extension goes
  // to that format page (locale-correct); anything else scrolls to the tool.
  (() => {
    const q = new URLSearchParams(location.search).get('q');
    if (q === null) return;
    const needle = q.trim().toLowerCase();
    const hit = needle
      ? formatKeys.find((f) => f.keys.includes(needle))
      : undefined;
    if (hit) {
      location.replace(`${localePrefix}/formats/${hit.slug}`);
      return;
    }
    document.getElementById('tool')?.scrollIntoView();
  })();
</script>
