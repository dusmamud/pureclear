---
import { REPORT_API_BASE } from '../lib/report';
import type { Translate } from '../lib/t';

interface Props {
  tr: Translate;
}

const { tr } = Astro.props;
---

<div
  id="report"
  data-report-form
  data-api-base={REPORT_API_BASE}
  data-not-specified={tr('report.notSpecified')}
  data-not-configured={tr('report.notConfigured')}
  data-sending={tr('report.sending')}
  data-success={tr('report.success')}
  data-error={tr('report.error')}
  class="rounded-[24px] bg-card p-6 ring-1 ring-hairline sm:p-8"
>
  <h3 class="text-[20px] font-semibold tracking-[-0.01em] sm:text-[22px]">
    {tr('report.title')}
  </h3>
  <p class="mt-2 text-[15px] leading-relaxed text-ink-2">
    {tr('report.intro')}
  </p>

  {/* Auto-filled diagnostics — read-only, sanitized */}
  <dl data-diagnostics class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
    <div class="rounded-2xl bg-canvas/70 px-4 py-3 ring-1 ring-hairline">
      <dt class="text-[12px] font-medium text-ink-2">
        {tr('report.reasonLabel')}
      </dt>
      <dd data-field-reason class="mt-1 text-[14px] font-medium">—</dd>
    </div>
    <div class="rounded-2xl bg-canvas/70 px-4 py-3 ring-1 ring-hairline">
      <dt class="text-[12px] font-medium text-ink-2">
        {tr('report.fileTypeLabel')}
      </dt>
      <dd data-field-ext class="mt-1 text-[14px] font-medium uppercase">—</dd>
    </div>
    <div class="rounded-2xl bg-canvas/70 px-4 py-3 ring-1 ring-hairline">
      <dt class="text-[12px] font-medium text-ink-2">
        {tr('report.sizeLabel')}
      </dt>
      <dd data-field-size class="mt-1 text-[14px] font-medium">—</dd>
    </div>
  </dl>
  <p class="mt-3 text-[13px] leading-relaxed text-ink-2">
    {tr('report.privacyNote')}
  </p>

  <form data-form class="mt-6">
    <label for="report-message" class="block text-[14px] font-medium">
      {tr('report.messageLabel')}
      {' '}
      <span class="font-normal text-ink-2">({tr('report.optional')})</span>
    </label>
    <textarea
      id="report-message"
      data-message
      rows="4"
      maxlength="2000"
      placeholder={tr('report.messagePlaceholder')}
      class="mt-2 w-full rounded-2xl border border-hairline bg-canvas/70 px-4 py-3 text-[15px] text-ink placeholder:text-ink-2/60 focus:border-accent focus:outline-none"
    ></textarea>

    <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
      <button
        type="submit"
        data-submit
        class="inline-flex items-center justify-center rounded-full bg-accent px-7 py-3 text-[15px] font-medium text-white transition-[color,background-color,transform] duration-200 hover:bg-accent-hover active:scale-[0.98] disabled:opacity-50"
      >
        {tr('report.submit')}
      </button>
      <p data-status class="text-[14px] text-ink-2" role="status" aria-live="polite"></p>
    </div>
  </form>
</div>

<script>
  import { APP_VERSION, browserFamily, osFamily, pagePath } from '../lib/report';

  (() => {
    const root = document.querySelector<HTMLElement>('[data-report-form]');
    if (!root) return;
    const apiBase = root.dataset.apiBase;
    const params = new URLSearchParams(location.search);

    // Kept local (not lib/report's sizeBucket): a missing/invalid size
    // must display and send '—', while the lib helper returns '>100MB'
    // for NaN. Payload values stay identical to before.
    const sizeBucket = (bytes: number): string => {
      const mb = bytes / (1024 * 1024);
      if (!(mb >= 0)) return '—';
      if (mb < 1) return '<1MB';
      if (mb < 10) return '1-10MB';
      if (mb < 100) return '10-100MB';
      return '>100MB';
    };

    const reason = (params.get('reason') || '').slice(0, 40) || 'unknown';
    const ext = (params.get('ext') || '').toLowerCase().slice(0, 10) || '—';
    const sizeBytes = parseInt(params.get('size') || '', 10);

    const reasonEl = root.querySelector<HTMLElement>('[data-field-reason]');
    if (reasonEl) {
      reasonEl.textContent =
        reason === 'unknown'
          ? root.dataset.notSpecified || 'Not specified'
          : reason;
    }
    const extEl = root.querySelector<HTMLElement>('[data-field-ext]');
    if (extEl) extEl.textContent = ext;
    const sizeEl = root.querySelector<HTMLElement>('[data-field-size]');
    if (sizeEl) sizeEl.textContent = sizeBucket(sizeBytes);

    const form = root.querySelector<HTMLFormElement>('[data-form]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit]');
    const messageEl = root.querySelector<HTMLTextAreaElement>('[data-message]');
    if (!form || !status || !submitBtn || !messageEl) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!apiBase) {
        status.textContent = root.dataset.notConfigured || 'Reporting is not available yet.';
        return;
      }
      submitBtn.disabled = true;
      status.textContent = root.dataset.sending || 'Sending…';
      const payload = {
        type: 'report',
        reason,
        fileExt: ext === '—' ? '' : ext,
        sizeBucket: sizeBucket(sizeBytes),
        browser: browserFamily(),
        os: osFamily(),
        appVersion: APP_VERSION,
        message: (messageEl.value || '').slice(0, 2000),
        page: pagePath(),
        timestamp: new Date().toISOString(),
      };
      try {
        const res = await fetch(apiBase + '/report', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          status.textContent = root.dataset.success || 'Thanks — report sent.';
          form.reset();
        } else {
          status.textContent =
            (root.dataset.error || 'Could not send. Please try again.') + ` (HTTP ${res.status})`;
        }
      } catch {
        status.textContent = root.dataset.error || 'Could not send. Please try again.';
      } finally {
        submitBtn.disabled = false;
      }
    });
  })();
</script>
