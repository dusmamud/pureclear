---
import ToolIsland from './tool/ToolIsland';
import { getRawMessages } from '../lib/messages';
import { type Locale } from '../lib/i18n';
import type { Translate } from '../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
}

const { locale, tr } = Astro.props;
const messages = getRawMessages(locale);
---

<section class="mx-auto max-w-6xl px-4 pb-16 pt-14 text-center sm:px-6 sm:pt-20">
  <p
    class="inline-flex items-center rounded-full border border-hairline bg-card px-4 py-1.5 text-[13px] font-medium text-ink-2 shadow-card"
  >
    <span class="me-2 inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
    {tr('hero.badge')}
  </p>
  <h1
    class="mx-auto mt-6 max-w-3xl text-[clamp(2rem,5vw,3.75rem)] font-semibold leading-[1.08] tracking-[-0.02em]"
  >
    {tr('hero.title')}
  </h1>
  <p class="mx-auto mt-5 max-w-2xl text-[clamp(1rem,2vw,1.25rem)] leading-relaxed text-ink-2">
    {tr('hero.subtitle')}
  </p>

  <div class="mx-auto mt-10 max-w-3xl text-start">
    <ToolIsland client:load locale={locale} messages={messages} />
  </div>
</section>
