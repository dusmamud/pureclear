---
import ToolIsland from './tool/ToolIsland';
import { getRawMessages } from '../lib/messages';
import { type Locale } from '../lib/i18n';
import type { Translate } from '../lib/t';

interface Props {
  locale: Locale;
  tr: Translate;
}

const { locale, tr } = Astro.props;
const messages = getRawMessages(locale);
---

<section class="mx-auto max-w-6xl px-4 pb-20 pt-16 text-center sm:px-6 sm:pb-28 sm:pt-24">
  {/* Eyebrow badge — Apple style: minimal pill */}
  <p
    class="inline-flex items-center gap-2 rounded-full bg-accent/10 px-4 py-1.5 text-[13px] font-semibold text-accent"
  >
    <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
    {tr('hero.badge')}
  </p>

  {/* Headline — Apple scale: massive, tight tracking */}
  <h1
    class="mx-auto mt-6 max-w-4xl text-[clamp(2.5rem,6vw,4.5rem)] font-semibold leading-[1.05] tracking-[-0.025em]"
  >
    {tr('hero.title')}
  </h1>

  {/* Subheadline — Apple gray, 21px */}
  <p
    class="mx-auto mt-6 max-w-2xl text-[clamp(1.0625rem,2vw,1.3125rem)] leading-[1.45] tracking-[-0.01em] text-ink-2"
  >
    {tr('hero.subtitle')}
  </p>

  {/* Hero visual — Apple style product shot, transparent background */}
  <div class="mx-auto mt-10 max-w-2xl sm:mt-12">
    <img
      src="/images/hero-phone.webp"
      alt={tr('hero.imageAlt')}
      class="h-auto w-full"
      width="1920"
      height="1280"
      fetchpriority="high"
    />
  </div>

  {/* Tool — the product, presented like an Apple product shot */}
  <div class="mx-auto mt-12 max-w-3xl text-start sm:mt-16">
    <ToolIsland client:load locale={locale} messages={messages} />
  </div>
</section>
