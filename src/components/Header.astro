---
import ThemeToggle from './ThemeToggle.astro';
import { LOCALES, LOCALE_META, localePath, type Locale } from '../lib/i18n';
import type { Translate } from '../lib/t';

interface Props {
  locale: Locale;
  path: string;
  tr: Translate;
}

const { locale, path, tr } = Astro.props;

const links = [
  { href: localePath(locale, '/'), label: tr('nav.home') },
  { href: localePath(locale, '/formats/jpg'), label: tr('nav.formats') },
  { href: localePath(locale, '/how-it-works'), label: tr('nav.howItWorks') },
  { href: localePath(locale, '/about'), label: tr('nav.about') },
  { href: localePath(locale, '/privacy'), label: tr('nav.privacy') },
];
---

<header class="sticky top-0 z-50 border-b border-hairline bg-[#fafafc] dark:bg-[#08080a]">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6"
    aria-label="Primary"
  >
    <a href={localePath(locale, '/')} class="flex items-center gap-2 font-semibold tracking-tight">
      <svg
        class="h-8 w-8"
        viewBox="0 0 64 64"
        aria-hidden="true"
      >
        <rect width="64" height="64" rx="14" fill="#0071e3" />
        <circle cx="32" cy="32" r="21" stroke="#fff" stroke-width="4" fill="none" opacity="0.35" />
        <path
          d="M20 34.5 28.5 43 44 25"
          stroke="#fff"
          stroke-width="6"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
        />
      </svg>
      <span class="text-[17px]">PureClear</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class="rounded-full px-3 py-2 text-sm text-ink-2 transition-colors hover:bg-black/5 hover:text-ink dark:hover:bg-white/10"
          >
            {label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <label class="relative hidden items-center sm:flex">
        <span class="sr-only">{tr('nav.language')}</span>
        <svg
          class="pointer-events-none absolute start-2.5 h-4 w-4 text-ink-2"
          viewBox="0 0 256 256"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm87.63,96H175.8a173.16,173.16,0,0,0-15.38-56.27A88.12,88.12,0,0,1,215.63,120ZM128,40c11.09,0,26.52,13.78,35.72,56.31A181.16,181.16,0,0,1,168,120H88a181.16,181.16,0,0,1,4.28-23.69C101.48,53.78,116.91,40,128,40ZM40.37,120A88.12,88.12,0,0,1,95.58,63.73,173.16,173.16,0,0,0,80.2,120Zm0,16H80.2a173.16,173.16,0,0,0,15.38,56.27A88.12,88.12,0,0,1,40.37,136ZM128,216c-11.09,0-26.52-13.78-35.72-56.31A181.16,181.16,0,0,1,88,136h80a181.16,181.16,0,0,1-4.28,23.69C154.52,202.22,139.09,216,128,216Zm22.42-23.73A173.16,173.16,0,0,0,175.8,136h39.83A88.12,88.12,0,0,1,160.42,192.27Z" />
        </svg>
        <select
          id="locale-switcher"
          class="appearance-none rounded-full border border-hairline bg-card py-2 pe-3 ps-8 text-sm text-ink"
          aria-label={tr('nav.language')}
        >
          {
            LOCALES.map((l) => (
              <option value={l} selected={l === locale}>
                {LOCALE_META[l].nativeLabel}
              </option>
            ))
          }
        </select>
      </label>
      <ThemeToggle tr={tr} />
      {/* Hamburger — mobile only, Apple.com style (two lines → X) */}
      <button
        id="menu-button"
        class="flex h-10 w-10 items-center justify-center rounded-full text-ink transition-colors hover:bg-black/5 md:hidden dark:hover:bg-white/10"
        aria-label={tr('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="menu-icon-open"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="7" x2="17" y2="7" />
          <line x1="3" y1="13" x2="17" y2="13" />
        </svg>
        <svg
          id="menu-icon-close"
          class="hidden h-5 w-5"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="5" y1="5" x2="15" y2="15" />
          <line x1="15" y1="5" x2="5" y2="15" />
        </svg>
      </button>
    </div>
  </nav>

  {/* Mobile menu overlay — full-screen, Apple.com style */}
  <div
    id="mobile-menu"
    class="invisible fixed inset-0 top-16 z-40 bg-canvas/95 opacity-0 backdrop-blur-xl transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] md:hidden"
    aria-hidden="true"
  >
    <nav class="mx-auto max-w-6xl px-6 py-8" aria-label={tr('nav.menu')}>
      <ul class="space-y-1">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="block rounded-2xl px-4 py-3.5 text-[19px] font-medium tracking-tight text-ink transition-colors hover:bg-black/5 dark:hover:bg-white/10"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 border-t border-hairline px-4 pt-6 sm:hidden">
        <label class="block text-sm text-ink-2">
          {tr('nav.language')}
          <select
            id="locale-switcher-mobile"
            class="mt-2 w-full appearance-none rounded-2xl border border-hairline bg-card px-4 py-3 text-[16px] text-ink"
            aria-label={tr('nav.language')}
          >
            {
              LOCALES.map((l) => (
                <option value={l} selected={l === locale}>
                  {LOCALE_META[l].nativeLabel}
                </option>
              ))
            }
          </select>
        </label>
      </div>
    </nav>
  </div>

  <script is:inline define:vars={{ path }}>
    // Locale switcher: navigate to the same page in the chosen locale.
    const switchLocale = (select) => {
      select?.addEventListener('change', (e) => {
        const next = e.target.value;
        const url = next === 'en' ? path : `/${next}${path === '/' ? '' : path}`;
        location.href = url || '/';
      });
    };
    switchLocale(document.getElementById('locale-switcher'));
    switchLocale(document.getElementById('locale-switcher-mobile'));

    // Hamburger menu toggle (Apple.com style overlay).
    const menuButton = document.getElementById('menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const setMenu = (open) => {
      menuButton?.setAttribute('aria-expanded', String(open));
      mobileMenu?.setAttribute('aria-hidden', String(!open));
      mobileMenu?.classList.toggle('invisible', !open);
      mobileMenu?.classList.toggle('opacity-0', !open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      document.body.classList.toggle('overflow-hidden', open);
    };
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') !== 'true';
      setMenu(open);
    });
    // Close on Escape.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setMenu(false);
    });
  </script>
</header>
