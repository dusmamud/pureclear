---
import type { Translate } from '../lib/t';

interface Props {
  tr: Translate;
}

const { tr } = Astro.props;

// Note: Phosphor React components can't render in Astro files —
// bento icons use inline SVG paths (Phosphor regular weight) instead.
const cards = [
  {
    title: tr('features.c1t'),
    body: tr('features.c1b'),
    path: 'M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm48-88a48,48,0,0,1-48,48V80A48,48,0,0,1,176,128Z',
  },
  {
    title: tr('features.c2t'),
    body: tr('features.c2b'),
    path: 'M213.66,114.66l-72,72a8,8,0,0,1-11.32-11.32L201.69,104H114a8,8,0,0,1,0-16h87.69L130.34,16.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,213.66,114.66Z',
  },
  {
    title: tr('features.c3t'),
    body: tr('features.c3b'),
    path: 'M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,16a88,88,0,1,1-88,88A88.1,88.1,0,0,1,128,40Zm-16,64a8,8,0,0,1,8-8h16a8,8,0,0,1,0,16H112A8,8,0,0,1,112,104Zm0,32a8,8,0,0,1,8-8h32a8,8,0,0,1,0,16H112A8,8,0,0,1,112,136Z',
  },
  {
    title: tr('features.c4t'),
    body: tr('features.c4b'),
    path: 'M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z',
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
  {/* Section header — Apple style: eyebrow + massive headline */}
  <div class="mx-auto max-w-3xl text-center">
    <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-accent">
      {tr('features.eyebrow')}
    </p>
    <h2
      class="mt-3 text-[clamp(1.75rem,4vw,2.75rem)] font-semibold leading-[1.1] tracking-[-0.02em]"
    >
      {tr('features.title')}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-[17px] leading-relaxed text-ink-2">
      {tr('features.subtitle')}
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-5 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4">
    {
      cards.map((c) => (
        <article class="group rounded-card bg-card p-7 shadow-card transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 hover:shadow-[0_12px_40px_rgb(0_0_0/0.1)]">
          <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/10 text-accent transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110">
            <svg class="h-6 w-6" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d={c.path} />
            </svg>
          </span>
          <h3 class="mt-5 text-[19px] font-semibold tracking-[-0.01em]">{c.title}</h3>
          <p class="mt-2 text-[15px] leading-[1.5] text-ink-2">{c.body}</p>
        </article>
      ))
    }
  </div>
</section>
