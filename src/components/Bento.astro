---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      cards.map((c) => (
        <article class="rounded-card border border-hairline bg-card p-6 shadow-card transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent/10 text-accent">
            <svg class="h-6 w-6" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
              <path d={c.path} />
            </svg>
          </span>
          <h3 class="mt-4 text-[17px] font-semibold tracking-tight">{c.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-2">{c.body}</p>
        </article>
      ))
    }
  </div>
</section>
