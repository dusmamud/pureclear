---
import type { Translate } from '../lib/t';

interface Props {
  tr: Translate;
}

const { tr } = Astro.props;

const faqs = [
  { q: tr('faq.q1'), a: tr('faq.a1') },
  { q: tr('faq.q2'), a: tr('faq.a2') },
  { q: tr('faq.q3'), a: tr('faq.a3') },
  { q: tr('faq.q4'), a: tr('faq.a4') },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-accent">
      {tr('faq.eyebrow') ?? 'FAQ'}
    </p>
    <h2
      class="mt-3 text-[clamp(1.75rem,4vw,2.5rem)] font-semibold leading-[1.12] tracking-[-0.02em]"
    >
      {tr('faq.title')}
    </h2>
  </div>
  <div class="mt-10 overflow-hidden rounded-card bg-card shadow-card sm:mt-12">
    {
      faqs.map((f, i) => (
        <details
          class={`group px-6 py-5 transition-colors hover:bg-black/[0.02] dark:hover:bg-white/[0.03] sm:px-8 sm:py-6 ${i > 0 ? 'border-t border-hairline' : ''}`}
        >
          <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              <span class="text-[17px] font-semibold tracking-[-0.01em]">{f.q}</span>
              <svg
                class="h-4 w-4 shrink-0 text-ink-2 transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-open:rotate-180"
                viewBox="0 0 256 256"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M213.66,165.66a8,8,0,0,1-11.32,0L128,91.31,53.66,165.66a8,8,0,0,1-11.32-11.32l80-80a8,8,0,0,1,11.32,0l80,80A8,8,0,0,1,213.66,165.66Z" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 max-w-2xl text-[15px] leading-[1.6] text-ink-2">{f.a}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</section>
