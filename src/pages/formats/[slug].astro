---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormatPage from '../../components/pages/FormatPage.astro';
import { FORMAT_SLUGS, getFormat } from '../../data/formats';

export function getStaticPaths() {
  return FORMAT_SLUGS.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const locale = 'en' as const;
const info = getFormat(slug);
if (!info) throw new Error(`Unknown format: ${slug}`);
---

<BaseLayout
  locale={locale}
  title={`${info.seoTitle[locale]} | PureClear`}
  description={info.seoDescription[locale]}
  path={`/formats/${slug}`}
  ogImage={`/og/${slug}.png`}
>
  <FormatPage locale={locale} format={info.slug} />
</BaseLayout>
