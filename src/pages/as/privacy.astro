---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyPage from '../../components/pages/PrivacyPage.astro';
import { t } from '../../lib/t';

const locale = 'as' as const;
const tr = t(locale);
---

<BaseLayout
  locale={locale}
  title={`${tr('privacy.title')} — PureClear`}
  description={tr('privacy.body')}
  path="/privacy"
>
  <PrivacyPage locale={locale} tr={tr} />
</BaseLayout>
