---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FormatsGrid from '../../../components/FormatsGrid.astro';
import { FORMATS } from '../../../data/formats';
import { t } from '../../../lib/t';
import { localePath } from '../../../lib/i18n';

const locale = 'hi' as const;
const tr = t(locale);

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: tr('formats.gridTitle'),
  description: tr('formats.indexDescription'),
  itemListElement: FORMATS.map((f, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${f.name} — ${f.tagline[locale]}`,
    url: `https://pureclear.dusrel.com${localePath(locale, `/formats/${f.slug}`)}`,
  })),
};
---

<BaseLayout
  locale={locale}
  title={`${tr('formats.indexTitle')} | PureClear`}
  description={tr('formats.indexDescription')}
  path="/formats"
  ogImage="/og/default.png"
>
  <FormatsGrid locale={locale} asPage />
  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} is:inline />
</BaseLayout>
