---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HowPage from '../../components/pages/HowPage.astro';
import { t } from '../../lib/t';

const locale = 'hi' as const;
const tr = t(locale);
---

<BaseLayout
  locale={locale}
  title={tr('how.metaTitle')}
  description={tr('how.metaDescription')}
  path="/how-it-works"
>
  <HowPage locale={locale} tr={tr} />
</BaseLayout>
