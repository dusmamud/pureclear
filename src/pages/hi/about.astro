---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutPage from '../../components/pages/AboutPage.astro';
import { t } from '../../lib/t';

const locale = 'hi' as const;
const tr = t(locale);
---

<BaseLayout
  locale={locale}
  title={`${tr('about.title')} — PureClear`}
  description={tr('about.body')}
  path="/about"
>
  <AboutPage locale={locale} tr={tr} />
</BaseLayout>
